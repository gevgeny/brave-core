   CHECK(ContainsIndex(index));
+  // STICKY_TABS: intercept user-initiated close. Yellow (left home) resets;
+  // green (at home) asks for confirmation. Programmatic closes (session
+  // restore, quit, extension API) skip this because they omit USER_GESTURE.
+  if (close_types & CLOSE_USER_GESTURE) {
+    if (auto* sticky =
+            tabs::StickyTabController::From(GetTabAtIndex(index));
+        sticky && sticky->is_sticky()) {
+      if (sticky->has_left_home()) {
+        sticky->ResetToHome();
+        return;
+      }
+      content::WebContents* contents = GetWebContentsAt(index);
+      sticky->ShowCloseConfirmDialog(base::BindOnce(
+          &TabStripModel::CloseWebContents, weak_factory_.GetWeakPtr(),
+          contents, close_types & ~CLOSE_USER_GESTURE));
+      return;
+    }
+  }
   CloseWebContents(GetWebContentsAt(index), close_types);
 }
 

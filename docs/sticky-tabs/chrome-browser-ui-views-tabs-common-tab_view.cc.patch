 bool TabView::OnMousePressed(const ui::MouseEvent& event) {
+  // STICKY_TABS: double-click on a titled sticky tab renames it.
+  if (event.IsOnlyLeftMouseButton() && event.GetClickCount() == 2) {
+    // TabView only exposes a const TabInterface; the tab itself is mutable.
+    auto* tab = const_cast<tabs::TabInterface*>(GetTabInterface());
+    auto* sticky = tabs::StickyTabController::From(tab);
+    if (sticky && sticky->is_sticky() && !tab->IsPinned()) {
+      sticky->ShowRenameDialog();
+      return true;
+    }
+  }
   CHECK(collection_node_);
 
   auto* controller = collection_node_->GetController();
